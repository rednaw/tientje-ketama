{
  "name": "Tientje Ketama",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.override.yml"],
  "service": "app",
  "workspaceFolder": "/workspaces/tientje-ketama",
  "containerEnv": {
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "safe.directory",
    "GIT_CONFIG_VALUE_0": "*"
  },
  "mounts": [
    "source=cursor-state,target=/home/node/.cursor,type=volume",
    "source=${localEnv:HOME}/.cursor/skills,target=/home/node/.cursor/skills,type=bind",
    "source=${localEnv:HOME}/.cursor/skills,target=/workspaces/tientje-ketama/.cursor/skills,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/home/node/.ssh,type=bind",
    "source=${localEnv:HOME}/.config/sops,target=/home/node/.config/sops,type=bind,readonly"
  ],
  "features": {"ghcr.io/devcontainers/features/git:1": {}},
  "forwardPorts": [5173, 5432],
  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode",
        "prisma.prisma",
        "signageos.signageos-vscode-sops",
        "mikestead.dotenv"
      ],
      "settings": {
        "sops.defaults.ageKeyFile": "/home/node/.config/sops/age/keys.txt",
        "files.associations": {
          "*.env": "dotenv",
          ".env": "dotenv"
        }
      },
      "remote.containers.autoReopen": true
    }
  },
  "remoteUser": "node"
}
